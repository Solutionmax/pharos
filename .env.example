APP_NAME=Pharos
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://status.example.com

# Never bake a URL into the code: moving to your own domain later must stay a
# one-line change here.
PHAROS_DOCS_URL=https://pharos.solutionmax.net/docs

# SQLite needs no server and is enough for a single status page.
# On shared hosting with MySQL, switch to the block below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pharos
# DB_USERNAME=
# DB_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=warning

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="status@example.com"
# Blank = the brand name from Branding.
MAIL_FROM_NAME=

# Public half only. The private key stays with the vendor.
PHAROS_BUY_URL=https://solutionmax.net/pharos

# How many days the audit log keeps a line before it is pruned. Settings → General overrides this.
PHAROS_AUDIT_DAYS=180

# Build stamps this from the git tag; never edit a version constant.
PHAROS_UPDATE_URL=https://pharos.solutionmax.net/releases/latest.json

# Backups made before an update, by Back up now, or as a rollback's safety net.
# The newest N are kept, ~30 MB each; 0 keeps them all. Settings → General overrides this.
PHAROS_KEEP_BACKUPS=3
