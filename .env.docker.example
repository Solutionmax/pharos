# Copy to .env before running compose. APP_KEY is required; generate one with:
#   docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_URL=http://localhost:8080
PHAROS_PORT=8080
PHAROS_LICENSE_PUBLIC_KEY=
# Set when a reverse proxy sits in front (its address or *), so limits see the visitor's IP.
TRUSTED_PROXIES=
